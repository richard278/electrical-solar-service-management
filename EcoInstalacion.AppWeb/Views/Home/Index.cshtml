@{
    ViewData["Title"] = "Home Page";
}

<style>
    .hero-eco {
        min-height: calc(100vh - 120px);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        background: linear-gradient(135deg, #004d7a, #008793, #00bf72, #a8eb12);
        color: #ffffff;
        padding: 2rem 1rem;
    }

    .hero-card {
        background: rgba(255,255,255,0.96);
        border-radius: 1.25rem;
        padding: 2rem 2.5rem;
        max-width: 650px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.18);
        animation: fadeInUp 1.3s ease-out;
    }

    .hero-logo {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 8px 20px rgba(0,0,0,0.25);
        margin-bottom: 1rem;
        background: #ffffff;
        padding: .5rem;
    }

    .hero-title {
        font-size: 2.2rem;
        font-weight: 800;
        color: #116520;
        margin-bottom: .5rem;
    }

    .hero-subtitle {
        font-size: 1rem;
        color: #4a5568;
        margin-bottom: 1.5rem;
    }

    .slogan {
        font-size: 1.25rem;
        font-weight: 600;
        color: #116520;
        margin-bottom: .75rem;
    }

    /* Pequeña animación para el slogan */
    @@keyframes fadeInUp {
        0% {
            opacity: 0;
            transform: translateY(20px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .btn-eco {
        border-radius: 999px;
        padding: .75rem 2.5rem;
        font-weight: 700;
        font-size: 1rem;
        letter-spacing: .03em;
        box-shadow: 0 10px 25px rgba(16, 185, 129, 0.45);
        transition: transform .15s ease, box-shadow .15s ease, background-color .15s ease;
    }

        .btn-eco:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 35px rgba(16, 185, 129, 0.60);
        }

    .eco-pill {
        display: inline-flex;
        align-items: center;
        padding: .25rem .75rem;
        border-radius: 999px;
        font-size: .8rem;
        background: #e6fffa;
        color: #047857;
        margin-bottom: 1rem;
    }
</style>

<div class="hero-eco">
    <div class="hero-card">

        <div class="eco-pill">
            <i class="fas fa-leaf mr-1"></i>
            Instalaciones eficientes & energía limpia
        </div>

        <img class="hero-logo"
             src="https://w7.pngwing.com/pngs/448/896/png-transparent-environmentally-friendly-cleaning-green-green-building-green-home-eco-building-logo-texas.png"
             alt="Eco Instalación" />

        <h1 class="hero-title">Bienvenido a Eco Instalación</h1>

        <p class="hero-subtitle">
            Plataforma de gestión para instalaciones responsables con el ambiente:
            clientes, técnicos y reportes en un solo ecosistema.
        </p>

        <p class="slogan">
            «Por un futuro amigable con el medio ambiente»
        </p>
        <p class="slogan">
            Agregando cuidado a su vida.
        </p>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <!-- Si ya inició sesión, lo llevamos directo al panel -->
            <a class="btn btn-success btn-eco mt-2"
               asp-controller="Usuarios"
               asp-action="Index">
                Ir al Panel Principal
            </a>
        }
        else
        {
            <a class="btn btn-outline-success" href="@Url.Action("Login", "Home")">
                <strong>INICIAR SESIÓN</strong>
            </a>
        }
    </div>
</div>
