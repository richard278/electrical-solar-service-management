@{
    ViewData["Title"] = "Roles";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Estilos {
    <link href="~/vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet" />
    <link href="~/vendor/datatables/extensiones/css/responsive.dataTables.min.css" rel="stylesheet" />
    <link href="~/vendor/datatables/extensiones/css/buttons.dataTables.min.css" rel="stylesheet" />
}

<div class="card shadow mb-4">
    <div class="card-header py-3 bg-second-primary">
        <h6 class="m-0 font-weight-bold text-white">CATÁLOGO DE ROLES DEL SISTEMA</h6>
    </div>
    <div class="card-body">
        <div class="alert alert-info" role="status">
            <i class="fas fa-shield-alt mr-1"></i>
            El catálogo es de solo lectura. Los únicos roles operativos son
            <strong>Administrador</strong> y <strong>Técnico</strong>.
        </div>

        <div class="row">
            <div class="col-sm-12">
                <table id="tbRoles" class="table table-bordered nowrap stripe" style="width:100%">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Descripción</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/dataTables.responsive.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/dataTables.buttons.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/jszip.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/buttons.html5.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/buttons.print.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const RUTA = "@Url.Content("~/")";

        function badgeEstado(esActivo) {
            return esActivo === 1
                ? '<span class="badge badge-info">Activo</span>'
                : '<span class="badge badge-secondary">Inactivo</span>';
        }

        $(document).ready(function () {
            $.fn.dataTable.ext.errMode = 'none';

            $("#tbRoles").DataTable({
                processing: true,
                responsive: true,
                ajax: {
                    url: RUTA + "Roles/Lista",
                    type: "GET",
                    dataSrc: function (json) {
                        if (Array.isArray(json)) return json;
                        if (json.data && Array.isArray(json.data)) return json.data;
                        return [];
                    },
                    error: function (xhr) {
                        console.error("Error DataTables AJAX:", xhr.status, xhr.responseText);
                        Swal.fire("Error", "No se pudieron cargar los roles.", "error");
                    }
                },
                columns: [
                    { data: "idRol" },
                    { data: "descripcion" },
                    { data: "esActivo", render: (d) => badgeEstado(d) }
                ],
                order: [[0, "asc"]],
                dom: 'Bfrtip',
                buttons: [
                    { extend: 'excel', text: 'Excel', className: 'btn btn-secondary btn-sm' },
                    { extend: 'print', text: 'Imprimir', className: 'btn btn-secondary btn-sm' }
                ]
            });
        });
    </script>
}
