
@{
    ViewData["Title"] = "Roles";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Estilos {
    <link href="~/vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet" />
    <link href="~/vendor/datatables/extensiones/css/responsive.dataTables.min.css" rel="stylesheet" />
    <link href="~/vendor/datatables/extensiones/css/buttons.dataTables.min.css" rel="stylesheet" />
}

<div class="card shadow mb-4">
    <div class="card-header py-3 bg-second-primary">
        <h6 class="m-0 font-weight-bold text-white">LISTADO DE ROLES</h6>
    </div>
    <div class="card-body">
        <div class="row mb-2">
            <div class="col-sm-4">
                <button class="btn btn-outline-success" id="btnNuevo">
                    <i class="fas fa-plus-circle"></i> NUEVO ROL
                </button>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <table id="tbRoles" class="table table-bordered nowrap stripe" style="width:100%">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Descripción</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Form sólo para el token anti-CSRF -->


<!-- Modal -->
<div class="modal fade" id="modalRol" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="__antiForgeryForm" asp-controller="Roles" asp-action="Index" method="post">
                @Html.AntiForgeryToken()
            
            <div class="modal-header">
                <h5 class="modal-title"><strong id="tituloModal">Nuevo rol</strong></h5>
            </div>
            <div class="modal-body">
                <input type="hidden" id="txtIdRol" value="0" />

                <input type="hidden" id="txtIdRol" value="0" />
                <div class="form-group">
                    <label>Descripción</label>
                    <input type="text" class="form-control form-control-sm" id="txtDescripcion" />
                </div>
                <div class="form-group">
                    <label>Estado</label>
                    <select id="cboEstado" class="form-control form-control-sm">
                        <option value="1">Activo</option>
                        <option value="0">Inactivo</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                    <!-- 👇 IMPORTANTÍSIMO: type="button" -->
                    <button type="button" class="btn btn-primary btn-sm" id="btnGuardar">Guardar</button>
                    <button type="button" class="btn btn-danger btn-sm" data-dismiss="modal">Cancelar</button>
            </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/dataTables.responsive.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/dataTables.buttons.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/jszip.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/buttons.html5.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/buttons.print.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const RUTA = "@Url.Content("~/")";
        let tabla;

        function getCsrf() {
            const tokenInput = document.querySelector('#__antiForgeryForm input[name="__RequestVerificationToken"]');
            return tokenInput ? tokenInput.value : '';
        }

        function badgeEstado(esActivo) {
            return esActivo == 1
                ? '<span class="badge badge-info">Activo</span>'
                : '<span class="badge badge-secondary">Inactivo</span>';
        }

        function limpiarModal() {
            $("#txtIdRol").val(0);
            $("#txtDescripcion").val("");
            $("#cboEstado").val(1);
            $("#tituloModal").text("Nuevo rol");
        }

        function abrirEdicion(data) {
            $("#txtIdRol").val(data.idRol);
            $("#txtDescripcion").val(data.descripcion);
            $("#cboEstado").val(data.esActivo);
            $("#tituloModal").text("Editar rol");
            $("#modalRol").modal("show");
        }

        $(document).ready(function () {

            // Para que DataTables no muestre el alert feo por defecto
            $.fn.dataTable.ext.errMode = 'none';

            tabla = $("#tbRoles").DataTable({
                processing: true,
                responsive: true,
                ajax: {
                    url: RUTA + "Roles/Lista",
                    type: "GET",
                    dataSrc: function (json) {
                        // Si llega el array correcto, lo devolvemos
                        if (Array.isArray(json)) return json;
                        // Fallback por si algún día volvemos a envolver en {data:[]}
                        if (json.data && Array.isArray(json.data)) return json.data;
                        return [];
                    },
                    error: function (xhr, error, thrown) {
                        console.error("Error DataTables AJAX:", xhr.status, xhr.responseText);
                        Swal.fire("Error", "No se pudieron cargar los roles.", "error");
                    }
                },
                columns: [
                    { data: "idRol" },
                    { data: "descripcion" },
                    {
                        data: "esActivo",
                        render: (d) => badgeEstado(d)
                    },
                    {
                        data: null,
                        orderable: false,
                        searchable: false,
                        render: function (data, type, row) {
                            return `
                                <button class="btn btn-primary btn-sm btn-editar"><i class="fas fa-pencil-alt"></i></button>
                                <button class="btn btn-danger btn-sm btn-eliminar"><i class="fas fa-trash-alt"></i></button>`;
                        }
                    }
                ],
                dom: 'Bfrtip',
                buttons: [
                    { extend: 'excel', text: 'Excel', className: 'btn btn-secondary btn-sm' },
                    { extend: 'print', text: 'Imprimir', className: 'btn btn-secondary btn-sm' }
                ]
            });

            $("#btnNuevo").on("click", function () {
                limpiarModal();
                $("#modalRol").modal("show");
            });

            $("#tbRoles tbody").on("click", "button.btn-editar", function () {
                const data = tabla.row($(this).closest("tr")).data();
                abrirEdicion(data);
            });

            $("#tbRoles tbody").on("click", "button.btn-eliminar", async function () {
                const data = tabla.row($(this).closest("tr")).data();
                const resp = await Swal.fire({
                    title: "¿Eliminar rol?",
                    text: `Se eliminará: ${data.descripcion}`,
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonText: "Sí, eliminar"
                });
                if (!resp.isConfirmed) return;

                $.ajax({
                    url: RUTA + "Roles/Eliminar?id=" + data.idRol,
                    type: "DELETE",
                    headers: { 'RequestVerificationToken': getCsrf() },
                    success: function (r) {
                        if (r.estado) {
                            Swal.fire("Listo", "Rol eliminado", "success");
                            tabla.ajax.reload();
                        } else {
                            Swal.fire("Aviso", r.mensaje || "No se pudo eliminar", "info");
                        }
                    },
                    error: function () {
                        Swal.fire("Error", "Ocurrió un error al eliminar", "error");
                    }
                });
            });

            $("#btnGuardar").on("click", function () {
                const payload = {
                    idRol: parseInt($("#txtIdRol").val() || "0"),
                    descripcion: $("#txtDescripcion").val().trim(),
                    esActivo: parseInt($("#cboEstado").val())
                };

                if (!payload.descripcion) {
                    Swal.fire("Validación", "La descripción es obligatoria", "info");
                    return;
                }

                const esNuevo = payload.idRol === 0;
                const url = RUTA + (esNuevo ? "Roles/Crear" : "Roles/Editar");
                const type = esNuevo ? "POST" : "PUT";

                $.ajax({
                    url,
                    type,
                    data: JSON.stringify(payload),
                    contentType: "application/json; charset=utf-8",
                    headers: { 'RequestVerificationToken': getCsrf() },
                    success: function (r) {
                        if (r.estado) {
                            $("#modalRol").modal("hide");
                            Swal.fire("Listo", "Cambios guardados", "success");
                            tabla.ajax.reload();
                        } else {
                            Swal.fire("Aviso", r.mensaje || "No se pudo guardar", "info");
                        }
                    },
                    error: function () {
                        Swal.fire("Error", "Ocurrió un error al guardar", "error");
                    }
                });
            });

        });
    </script>
}
